# Copy to .env (git-ignored) and fill in. Never commit .env.
# Use a dedicated, read-only MemberSuite staff user for this work (see docs/credentials.md).

# Numeric association (tenant) id
MS_TENANT_ID=
# Staff user that signs in to the API
MS_USERNAME=
# Leave empty to be asked at the prompt each run instead of storing it here
MS_PASSWORD=
# Only change if MemberSuite gives you a different host
MS_BASE_URL=https://rest.membersuite.com
